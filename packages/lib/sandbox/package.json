{
    "name": "@chatgpt-telegram-workers/sandbox",
    "version": "1.10.7",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./cloudflare": {
            "types": "./dist/cloudflare.d.ts",
            "import": "./dist/cloudflare.js"
        },
        "./durable-object": {
            "types": "./dist/durable-object.d.ts",
            "import": "./dist/durable-object.js"
        }
    },
    "scripts": {
